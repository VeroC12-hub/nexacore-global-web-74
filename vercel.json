{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ai/chat",
      "destination": "/api/ai/chat"
    },
    {
      "source": "/api/ai/jarvis",
      "destination": "/api/ai/jarvis"
    },
    {
      "source": "/api/ai/pitch",
      "destination": "/api/ai/pitch"
    },
    {
      "source": "/api/ai/sales-draft",
      "destination": "/api/ai/sales-draft"
    },
    {
      "source": "/api/ai/embeddings",
      "destination": "/api/ai/embeddings"
    },
    {
      "source": "/api/telegram/webhook",
      "destination": "/api/telegram/webhook"
    },
    {
      "source": "/api/cron/briefing",
      "destination": "/api/cron/briefing"
    },
    {
      "source": "/api/cron/reminders",
      "destination": "/api/cron/reminders"
    },
    {
      "source": "/api/push/subscribe",
      "destination": "/api/push/subscribe"
    },
    {
      "source": "/api/quotes/([^/]+)/pdf",
      "destination": "/api/quotes/[id]/pdf?id=$1"
    },
    {
      "source": "/api/admin/(delete-user|seed-keba-proposal|send-project-emails)",
      "destination": "/api/admin/[action]?action=$1"
    },
    {
      "source": "/api/agents/run",
      "destination": "/api/agents/run"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/briefing",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/quotes/:id",
      "destination": "/quote/:id",
      "permanent": true
    },
    {
      "source": "/quote-review/:id",
      "destination": "/quote/:id",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
